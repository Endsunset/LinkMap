{"abstract":[{"text":"Learn how to organize places and work in LinkMap on iOS and the web.","type":"text"}],"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc://io.github.endsunset.LinkMap/documentation/LinkMap"},"kind":"article","metadata":{"role":"collection","title":"LinkMap Documentation"},"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Start with Platforms to see how the two apps differ. The task sections below cover getting started, Projects and the Map, planning work, and collaboration. Essentials provides a short introduction.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Activities":{"abstract":[{"text":"An Activity is one round of work within a Project.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Activities","kind":"article","role":"collectionGroup","title":"Activities","type":"topic","url":"/documentation/activities"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Basic-Workflow":{"abstract":[{"text":"Follow one Project from a first place to a planned visit.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Basic-Workflow","kind":"article","role":"article","title":"Basic Workflow Example","type":"topic","url":"/documentation/basic-workflow"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Essentials":{"abstract":[{"text":"LinkMap centers on a Project: a shared map and a collection of Activities. Places remain available across Activities, so a team can plan another round of work without recreating its map.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Essentials","kind":"article","role":"collectionGroup","title":"Essentials","type":"topic","url":"/documentation/essentials"},"doc://io.github.endsunset.LinkMap/documentation/LinkM