{"abstract":[{"text":"Learn how to organize places and work in LinkMap on iOS and the web.","type":"text"}],"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc://io.github.endsunset.LinkMap/documentation/LinkMap"},"kind":"article","metadata":{"role":"collection","title":"LinkMap Documentation"},"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Start with Platforms to see how the two apps differ, then open the Handbook for step-by-step help. Essentials gives a short introduction, and Shared Concepts covers Projects, places, routes, and sharing.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Essentials":{"abstract":[{"text":"LinkMap centers on a Project: a shared map and a collection of Activities. Places remain available across Activities, so a team can plan another round of work without recreating its map.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Essentials","kind":"article","role":"collectionGroup","title":"Essentials","type":"topic","url":"/documentation/essentials"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Handbook":{"abstract":[{"text":"Follow the existing iOS guides for setting up Projects, organizing places, planning work, and sharing. For differences between the iOS app and web map, see ","type":"text"},{"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Platforms","isActive":true,"type":"reference"},{"text":".","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Handbook","kind":"article","role":"collectionGroup","title":"Handbook","type":"topic","url":"/documentation/handbook"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Platforms":{"abstract":[{"text":"LinkMap is available as an iOS app and a web map. Both can show the Projects and places available to you, but account access and available actions differ.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Platforms","kind":"article","role":"collectionGroup","title":"Platforms","type":"topic","url":"/documentation/platforms"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Shared-Concepts":{"abstract":[{"text":"Projects and Locations appear in both the iOS app and the web map. Use the iOS app to manage them, then open the web map to explore the places available to your account.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Shared-Concepts","kind":"article","role":"collectionGroup","title":"Shared Concepts","type":"topic","url":"/documentation/shared-concepts"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"topicSections":[{"anchor":"Platforms","identifiers":["doc://io.github.endsunset.LinkMap/documentation/LinkMap/Platforms"],"title":"Platforms"},{"anchor":"Handbook","identifiers":["doc://io.github.endsunset.LinkMap/documentation/LinkMap/Handbook"],"title":"Handbook"},{"anchor":"Essentials","identifiers":["doc://io.github.endsunset.LinkMap/documentation/LinkMap/Essentials"],"title":"Essentials"},{"anchor":"Shared-Concepts","identifiers":["doc://io.github.endsunset.LinkMap/documentation/LinkMap/Shared-Concepts"],"title":"Shared Concepts"}]}