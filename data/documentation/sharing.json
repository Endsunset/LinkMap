{"abstract":[{"text":"Share a Project when other people need to see and work with the same places and Activities.","type":"text"}],"hierarchy":{"paths":[["doc://io.github.endsunset.LinkMap/documentation/LinkMap","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Handbook","doc://io.github.endsunset.LinkMap/documentation/LinkMap/iOS-Handbook","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Using-LinkMap-for-iOS"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Sharing"},"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"Sharing"},"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Open the Project’s collaboration tools to send a LinkMap invitation or show its QR code. A collaborator can open the invitation or use Dashboard → Scan. After joining, they can select the shared Project in Context.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When sharing ends, collaborators no longer see the Project after refreshing their Project list.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://io.github.endsunset.LinkMap/documentation/LinkMap":{"abstract":[{"text":"Learn how to organize places and work in LinkMap on iOS and the web.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap","kind":"article","role":"collection","title":"LinkMap","type":"topic","url":"/documentation"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Handbook":{"abstract":[{"text":"Follow the existing iOS guides for setting up Projects, organizing places, planning work, and sharing. For differences between the iOS app and web map, see ","type":"text"},{"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Platforms","isActive":true,"type":"reference"},{"text":".","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMa