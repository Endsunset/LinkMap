{"abstract":[{"text":"Locations are the places your team needs to find or visit, such as entrances, rooms, checkpoints, or delivery points.","type":"text"}],"hierarchy":{"paths":[["doc://io.github.endsunset.LinkMap/documentation/LinkMap","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Handbook","doc://io.github.endsunset.LinkMap/documentation/LinkMap/iOS-Handbook","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Using-LinkMap-for-iOS","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Project","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Map"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Locations"},"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"Locations"},"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Add and edit Locations from the Map. A Location has a position and can belong to a Region and Layer. Tap its marker and choose Detail to learn more. Routes reuse Project Locations as Stops, so you can plan new Activities from the same places.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://io.github.endsunset.LinkMap/documentation/LinkMap":{"abstract":[{"text":"Learn how LinkMap organizes shared places and work, use the iOS and web apps, and understand the implementation behind them.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap","kind":"article","role":"collection","title":"LinkMap","type":"topic","url":"/documentation/linkmap"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Handbook":{"abstract":[{"text":"Use the iOS handbook to create and manage work in the native app. Use the web handbook to explore Projects and Locations in a browser and to understand the website implementation.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Handbook