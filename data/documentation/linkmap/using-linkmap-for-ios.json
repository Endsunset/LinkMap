{"abstract":[{"text":"Use LinkMap to plan places and shared work from the Map.","type":"text"}],"hierarchy":{"paths":[["doc://io.github.endsunset.LinkMap/documentation/LinkMap","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Handbook","doc://io.github.endsunset.LinkMap/documentation/LinkMap/iOS-Handbook"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Using-LinkMap-for-iOS"},"kind":"article","metadata":{"role":"collectionGroup","title":"LinkMap for iOS"},"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The app opens on the Map. Open Dashboard to choose your current Project, Activity, and Assignment, or to open Project details. You can start with a simple Project map and add an Activity when you are ready to plan a round of work.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://io.github.endsunset.LinkMap/documentation/LinkMap":{"abstract":[{"text":"Learn how LinkMap organizes shared places and work, use the iOS and web apps, and understand the implementation behind them.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap","kind":"article","role":"collection","title":"LinkMap","type":"topic","url":"/documentation/linkmap"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Activities":{"abstract":[{"text":"An Activity is one round of work within a Project.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Activities","kind":"article","role":"collectionGroup","title":"Activities","type":"topic","url":"/documentation/linkmap/activities"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Basic-Workflow":{"abstract":[{"text":"Follow one Project from a first place to a planned visit.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Basic-Workflow","kind":"article","role":"