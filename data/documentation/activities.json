{"abstract":[{"text":"An Activity is one round of work within a Project.","type":"text"}],"hierarchy":{"paths":[["doc://io.github.endsunset.LinkMap/documentation/LinkMap","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Handbook","doc://io.github.endsunset.LinkMap/documentation/LinkMap/iOS-Handbook","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Using-LinkMap-for-iOS"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Activities"},"kind":"article","metadata":{"role":"collectionGroup","title":"Activities"},"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Create an Activity when you are ready to plan a visit, inspection, or other task. Add Routes for the places to visit and Assignments for the people or teams doing the work. Select the Activity in Dashboard → Context to show its route on the Map.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Archive an Activity after the work is finished. The Project and its Locations remain ready for another Activity.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://io.github.endsunset.LinkMap/documentation/LinkMap":{"abstract":[{"text":"Learn how to organize places and work in LinkMap on iOS and the web.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap","kind":"article","role":"collection","title":"LinkMap","type":"topic","url":"/documentation"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Assignments":{"abstract":[{"text":"An Assignment names the person, team, crew, or vehicle responsible for work in an Activity.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Assignments","kind":"article","role":"article","title":"Assignments","type":"topic","url":"/documentation/assignments"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Handbook":{"abstract":[{"text":"Follow the existing iOS guides for setting up Projects, organizing places, planning work, and sharing. For differences between the iOS app and web map, see ","type":"text"},{"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Platforms","isActive":true,"type":"reference"},{"text":".","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Handbook","kind":"article","role":"collectionGroup","title":"Handbook","type":"topic","url":"/documentation/handbook"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Platforms":{"abstract":[{"text":"LinkMap is available as an iOS app and a web map. Both can show the Projects and places available to you, but account access and available actions differ.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Platforms","kind":"article","role":"collectionGroup","title":"Platforms","type":"topic","url":"/documentation/platforms"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Routes-and-Stops":{"abstract":[{"text":"A Route puts places in the order your team should visit them. Each Stop uses a Location from the Project.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Routes-and-Stops","kind":"article","role":"article","title":"Routes and Stops","type":"topic","url":"/documentation/routes-and-stops"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Using-LinkMap-for-iOS":{"abstract":[{"text":"Use LinkMap to plan places and shared work from the Map.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Using-LinkMap-for-iOS","kind":"article","role":"collectionGroup","title":"LinkMap for iOS","type":"topic","url":"/documentation/using-linkmap-for-ios"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/iOS-Handbook":{"abstract":[{"text":"The iOS app starts on the Map. Use it to set up Projects, plan Activities, and share places with co