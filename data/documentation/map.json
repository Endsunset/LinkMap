{"abstract":[{"text":"The Map is the first screen in LinkMap. It stays visible even before you choose a Project.","type":"text"}],"hierarchy":{"paths":[["doc://io.github.endsunset.LinkMap/documentation/LinkMap","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Handbook","doc://io.github.endsunset.LinkMap/documentation/LinkMap/iOS-Handbook","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Using-LinkMap-for-iOS","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Project"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Map"},"kind":"article","metadata":{"role":"collectionGroup","title":"Map"},"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Open Dashboard → Context to select a Project, Activity, and optional Assignment. The Map shows the selected Project’s Locations. Selecting an Activity adds its Routes; selecting an Assignment focuses the view on that team’s work.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Tap a Location marker to open its actions, then choose Detail. Use the Map toolbar’s Edit Locations action to add or move places. Save to keep changes or Cancel to discard them.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://io.github.endsunset.LinkMap/documentation/LinkMap":{"abstract":[{"text":"Learn how to organize places and work in LinkMap on iOS and the web.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap","kind":"article","role":"collection","title":"LinkMap","type":"topic","url":"/documentation"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Handbook":{"abstract":[{"text":"Follow the existing iOS guides for setting up Projects, organizing places, planning work, and sharing. For differences between the iOS app and web map, see ","type":"text"},{"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Platforms","isActive":true,"type":"reference"},{"text":".","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Handbook","kind":"article","role":"collectionGroup","title":"Handbook","type":"topic","url":"/documentation/handbook"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Locations":{"abstract":[{"text":"Locations are the places your team needs to find or visit, such as entrances, rooms, checkpoints, or delivery points.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Locations","kind":"article","role":"article","title":"Locations","type":"topic","url":"/documentation/locations"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Platforms":{"abstract":[{"text":"LinkMap is available as an iOS app and a web map. Both can show the Projects and places available to you, but account access and available actions differ.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Platforms","kind":"article","role":"collectionGroup","title":"Platforms","type":"topic","url":"/documentation/platforms"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Project":{"abstract":[{"text":"A Project brings together the places and activities for one area or shared effort.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Project","kind":"article","role":"collectionGroup","title":"Project","type":"topic","url":"/documentation/project"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Regions-and-Layers":{"abstract":[{"text":"Regions divide a Project into broad areas. Layers describe levels or surfaces inside a Region, such as floors in a building.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Regions-and-Layers","kind":"article","role":"article","title":"Regions and Layers","type":"topic","url":"/documentation/regions-and-layers"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Using-LinkMap-for-iOS":{"abstract":[{"text":"Use LinkMap to plan places and shared work from the Map.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Using-LinkMap-for-iOS","kind":"article","role":"collectionGroup","title":"LinkMap for iOS","type":"topic","url":"/documentation/using-linkmap-for-ios"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/iOS-Handbook":{"abstract":[{"text":"The iOS app starts on the Map. Use it to set up Projects, plan Activities, and share places with collaborators.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/iOS-Handbook","kind":"article","role":"collectionGroup","title":"iOS Handbook","type":"topic","url":"/documentation/ios-handbook"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"topicSections":[{"anchor":"Organize-Places","identifiers":["doc://io.github.endsunset.LinkMap/documentation/LinkMap/Regions-and-Layers","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Locations"],"title":"Organize Places"}]}