{"abstract":[{"text":"The web map asks you to sign in with your Apple Account to view your Projects and their Locations. Sign-in is a separate step in the browser, even if you already use LinkMap on iOS.","type":"text"}],"hierarchy":{"paths":[["doc://io.github.endsunset.LinkMap/documentation/LinkMap","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Platforms"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Web-Platform"},"kind":"article","metadata":{"role":"collectionGroup","title":"LinkMap on the Web"},"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"You can search for places and inspect coordinates without signing in. Create Projects, plan Activities, and manage sharing in the iOS app.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://io.github.endsunset.LinkMap/documentation/LinkMap":{"abstract":[{"text":"Learn how to organize places and work in LinkMap on iOS and the web.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap","kind":"article","role":"collection","title":"LinkMap","type":"topic","url":"/documentation"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Platforms":{"abstract":[{"text":"LinkMap is available as an iOS app and a web map. Both can show the Projects and places available to you, but account access and available actions differ.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Platforms","kind":"article","role":"collectionGroup","title":"Platforms","type":"topic","url":"/documentation/platforms"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Web-Handbook":{"abstract":[{"text":"Use the web map to explore Projects and Locations. You can also search for places and inspect coordinates without signing in.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentatio