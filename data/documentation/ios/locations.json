{"abstract":[{"text":"Locations are the places your team needs to find or visit, such as entrances, rooms, checkpoints, or delivery points.","type":"text"}],"hierarchy":{"paths":[["doc://io.github.endsunset.LinkMap.iOS/documentation/iOS","doc://io.github.endsunset.LinkMap.iOS/documentation/iOS/Project","doc://io.github.endsunset.LinkMap.iOS/documentation/iOS/Map"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://io.github.endsunset.LinkMap.iOS/documentation/iOS/Locations"},"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"Locations"},"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Add and edit Locations from the Map. A Location has a position and can belong to a Region and Layer. Tap its marker and choose Detail to learn more. Routes reuse Project Locations as Stops, so you can plan new Activities from the same places.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://io.github.endsunset.LinkMap.iOS/documentation/iOS":{"abstract":[{"text":"Use LinkMap to plan places and shared work from the Map.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap.iOS/documentation/iOS","kind":"article","role":"collection","title":"iOS","type":"topic","url":"/documentation/ios"},"doc://io.github.endsunset.LinkMap.iOS/documentation/iOS/Map":{"abstract":[{"text":"The Map is the first screen in LinkMap. It stays visible even before you choose a Project.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap.iOS/documentation/iOS/Map","kind":"article","role":"collectionGroup","title":"Map","type":"topic","url":"/documentation/ios/map"},"doc://io.github.endsunset.LinkMap.iOS/documentation/iOS/Project":{"abstract":[{"text":"A Project brings together the places and activities for one area or shared effort.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap.iOS/documentation/iOS/Project","kind":"article","rol