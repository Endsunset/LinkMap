{"abstract":[{"text":"An Activity is one round of work within a Project.","type":"text"}],"hierarchy":{"paths":[["doc://io.github.endsunset.LinkMap.iOS/documentation/iOS"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://io.github.endsunset.LinkMap.iOS/documentation/iOS/Activities"},"kind":"article","metadata":{"role":"collectionGroup","title":"Activities"},"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Create an Activity when you are ready to plan a visit, inspection, or other task. Add Routes for the places to visit and Assignments for the people or teams doing the work. Select the Activity in Dashboard → Context to show its route on the Map.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Archive an Activity after the work is finished. The Project and its Locations remain ready for another Activity.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://io.github.endsunset.LinkMap.iOS/documentation/iOS":{"abstract":[{"text":"Use LinkMap to plan places and shared work from the Map.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap.iOS/documentation/iOS","kind":"article","role":"collection","title":"iOS","type":"topic","url":"/documentation/ios"},"doc://io.github.endsunset.LinkMap.iOS/documentation/iOS/Assignments":{"abstract":[{"text":"An Assignment names the person, team, crew, or vehicle responsible for work in an Activity.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap.iOS/documentation/iOS/Assignments","kind":"article","role":"article","title":"Assignments","type":"topic","url":"/documentation/ios/assignments"},"doc://io.github.endsunset.LinkMap.iOS/documentation/iOS/Routes-and-Stops":{"abstract":[{"text":"A Route puts places in the order your team should visit them. Each Stop uses a Location from the Project.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap.iOS/documentation/iOS/Routes-and-Stops","kind":"article","role":"article","title":"Routes and Stops","type":"topic","url":"/documentation/ios/routes-and-stops"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"topicSections":[{"anchor":"Plan-an-Activity","identifiers":["doc://io.github.endsunset.LinkMap.iOS/documentation/iOS/Routes-and-Stops","doc://io.github.endsunset.LinkMap.iOS/documentation/iOS/Assignments"],"title":"Plan an Activity"}]}