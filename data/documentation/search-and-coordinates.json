{"abstract":[{"text":"Use the web map to find a place or inspect a coordinate.","type":"text"}],"hierarchy":{"paths":[["doc://io.github.endsunset.LinkMap/documentation/LinkMap","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Platforms","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Web-Platform","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Web-Handbook","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Using-LinkMap-on-Web","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Explore-Projects"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Search-and-Coordinates"},"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"Search and Coordinates"},"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Type a place or address in Search and choose a suggestion or result. The map moves to the selected place and shows its details when available. You can also enter a latitude and longitude pair, choose Show on map, and use Copy to share the coordinate text.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Search results are map places; your Project Locations remain available when you change the search selection.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://io.github.endsunset.LinkMap/documentation/LinkMap":{"abstract":[{"text":"Learn how to organize places and work in LinkMap on iOS and the web.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap","kind":"article","role":"collection","title":"LinkMap","type":"topic","url":"/documentation"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Explore-Projects":{"abstract":[{"text":"Use the Project selector above the web map to choose the Project you want to view.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Explore-Projects","kind":"article","role":"collectionGroup","title":"Explore Projects on the Web","type":"topic","url":"/documentation/explore-projects"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Platforms":{"abstract":[{"text":"LinkMap is available as an iOS app and a web map. Both can show the Projects and places available to you, but account access and available actions differ.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Platforms","kind":"article","role":"collectionGroup","title":"Platforms","type":"topic","url":"/documentation/platforms"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Using-LinkMap-on-Web":{"abstract":[{"text":"Explore your Projects and places in a browser.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Using-LinkMap-on-Web","kind":"article","role":"collectionGroup","title":"LinkMap for Web","type":"topic","url":"/documentation/using-linkmap-on-web"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Web-Handbook":{"abstract":[{"text":"Use the web map to explore Projects and Locations. You can also search for places and inspect coordinates without signing in.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Web-Handbook","kind":"article","role":"collectionGroup","title":"Web Handbook","type":"topic","url":"/documentation/web-handbook"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Web-Platform":{"abstract":[{"text":"The web map asks you to sign in with your Apple Account to view your Projects and their Locations. Sign-in is a separate step in the browser, even if you already use LinkMap on iOS.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Web-Platform","kind":"article","role":"collectionGroup","title":"LinkMap on the Web","type":"topic","url":"/documentation/web-platform"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[]}