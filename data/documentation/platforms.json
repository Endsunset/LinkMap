{"abstract":[{"text":"LinkMap is available as an iOS app and a web map. Both can show the Projects and places available to you, but account access and available actions differ.","type":"text"}],"hierarchy":{"paths":[["doc://io.github.endsunset.LinkMap/documentation/LinkMap"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Platforms"},"kind":"article","metadata":{"role":"collectionGroup","title":"Platforms"},"references":{"doc://io.github.endsunset.LinkMap/documentation/LinkMap":{"abstract":[{"text":"Learn how to organize places and work in LinkMap on iOS and the web.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap","kind":"article","role":"collection","title":"LinkMap","type":"topic","url":"/documentation"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Web-Platform":{"abstract":[{"text":"The web map asks you to sign in with your Apple Account to view your Projects and their Locations. Sign-in is a separate step in the browser, even if you already use LinkMap on iOS.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Web-Platform","kind":"article","role":"collectionGroup","title":"LinkMap on the Web","type":"topic","url":"/documentation/web-platform"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/iOS-Platform":{"abstract":[{"text":"The iOS app uses the Apple Account signed in on your device for iCloud access. You do not need to sign in separately inside LinkMap.","type":"text"}],"identifier":"doc://io.github.endsunset.LinkMap/documentation/LinkMap/iOS-Platform","kind":"article","role":"article","title":"LinkMap on iOS","type":"topic","url":"/documentation/ios-platform"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"topicSections":[{"anchor":"Choose-a-Platform","identifiers":["doc://io.github.endsunset.LinkMap/documentation/LinkMap/iOS-Platform","doc://io.github.endsunset.LinkMap/documentation/LinkMap/Web-Platform"],"title":"Choose a Platform"}]}