{"kind":"article","hierarchy":{"paths":[["doc:\/\/io.github.endsunset.LinkMap\/documentation\/LinkMap"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/io.github.endsunset.LinkMap\/documentation\/LinkMap\/Activities"},"metadata":{"role":"article","title":"Activities","roleHeading":"Article"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"An Activity is one cycle of work within a Project.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Create an Activity after its Project foundation is ready. Assignments and Routes belong to that Activity; Routes contain ordered Stops that point to Project Locations. Resource movements can flow from Inventory to Activity and then among Activity, Assignment, and Stop anchors."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Archiving makes the Activity historical. The owner can archive it even when the Project is not actively shared. Archived Activity resource history remains readable."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/io.github.endsunset.LinkMap\/documentation\/LinkMap\/Routes-and-Stops","type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/io.github.endsunset.LinkMap\/documentation\/LinkMap\/Assignments-and-Resources","type":"reference"}]}]}],"type":"unorderedList"}]}],"sections":[],"references":{"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Assignments-and-Resources":{"type":"topic","kind":"article","identifier":"doc:\/\/io.github.endsunset.LinkMap\/documentation\/LinkMap\/Assignments-and-Resources","role":"article","abstract":[{"text":"An Assignment represents a person, team, crew, or vehicle working in an Activity.","type":"text"}],"url":"\/documentation\/linkmap\/assignments-and-resources","title":"