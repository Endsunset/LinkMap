{"kind":"article","hierarchy":{"paths":[["doc:\/\/io.github.endsunset.LinkMap\/documentation\/LinkMap"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/io.github.endsunset.LinkMap\/documentation\/LinkMap\/Assignments-and-Resources"},"metadata":{"role":"article","title":"Assignments and Resources","roleHeading":"Article"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"An Assignment represents a person, team, crew, or vehicle working in an Activity.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"An Assignment can have Routes and hold Item quantities through Transactions. Select an Assignment in Map Context to focus its routes and Locations. The Activity supply workflow can move Items from Inventory to Activity, then from Activity to a selected Assignment. Resource balances are derived from the transaction ledger."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/io.github.endsunset.LinkMap\/documentation\/LinkMap\/Routes-and-Stops","type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/io.github.endsunset.LinkMap\/documentation\/LinkMap\/Transactions-and-Reports","type":"reference"}]}]}],"type":"unorderedList"}]}],"sections":[],"references":{"doc://io.github.endsunset.LinkMap/documentation/LinkMap":{"identifier":"doc:\/\/io.github.endsunset.LinkMap\/documentation\/LinkMap","url":"\/documentation\/linkmap","title":"LinkMap","type":"topic","kind":"article","abstract":[{"text":"Plan places, resources, and shared work across iOS and the web.","type":"text"}],"role":"collection"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Transactions-and-Reports":{"url":"\/documentation\/linkmap\/transactions-and-reports","type":"topic","abstract":[{"text":"A Transaction records a positive quantity of one Item moving between resource anchors. Inventory, Activity, Assignment, and Stop are anchors; a balance equals incoming quantities minus outgoing quantities.","type":"text"}],"title":"Transactions and Reports","identifier":"doc:\/\/io.github.endsunset.LinkMap\/documentation\/LinkMap\/Transactions-and-Reports","kind":"article","role":"article"},"doc://io.github.endsunset.LinkMap/documentation/LinkMap/Routes-and-Stops":{"type":"topic","kind":"article","identifier":"doc:\/\/io.github.endsunset.LinkMap\/documentation\/LinkMap\/Routes-and-Stops","role":"article","abstract":[{"text":"A Route orders the places to visit during an Activity. Each Stop refers to a Project Location.","type":"text"}],"url":"\/documentation\/linkmap\/routes-and-stops","title":"Routes and Stops"}}}